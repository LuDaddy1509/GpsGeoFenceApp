<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MauiApp1.Pages"
    FlyoutBehavior="Disabled">

    <ShellContent
        Route="startup"
        Title="Khoi dong"
        ContentTemplate="{DataTemplate pages:StartupPage}" />

    <ShellContent
        Route="auth-choice"
        Title="Bat dau"
        ContentTemplate="{DataTemplate pages:AuthChoicePage}" />

    <ShellContent
        Route="login"
        Title="Dang nhap"
        ContentTemplate="{DataTemplate pages:LoginPage}" />

    <ShellContent
        Route="register"
        Title="Dang ky"
        ContentTemplate="{DataTemplate pages:RegisterPage}" />

    <ShellContent
        Route="map"
        Title="Ban do"
        ContentTemplate="{DataTemplate pages:MapPage}" />

</Shell>

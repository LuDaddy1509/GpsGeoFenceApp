<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Chi build Android. Bo Windows de tranh loi MAUIX2000 MauiWinUIApplication -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>GpsGeoFenceApp.Mobile</RootNamespace>
		<AssemblyName>GpsGeoFenceApp.Mobile</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<ApplicationTitle>GpsGeoFenceApp</ApplicationTitle>
		<ApplicationId>com.gpsgeofenceapp.mobile</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- ⬅️ ADD: Cho Windows -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0'">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<!-- ⬅️ ADD: Cho Android nếu dùng vector drawable -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidEnableVectorDrawables>true</AndroidEnableVectorDrawables>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
	  <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#17171a" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#17171a" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Syncfusion.Maui.Core" Version="33.1.49" />
		<PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.9" />
		<PackageReference Include="ZXing.Net.MAUI.Controls" Version="0.7.4" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="12.3.0" />
		<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.5" />
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.50" />
		<PackageReference Include="Microsoft.Maui.Maps" Version="10.0.50" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.9.1.7" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.10.0.2" />
		<PackageReference Include="Xamarin.GooglePlayServices.Location" Version="121.3.0.9" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Pages\LoginPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\MapPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\PoiDetailPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\QrScanPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\RegisterPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\SettingsPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\StartupPage.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Platforms\Shared\Services\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Configuration\appsettings*.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md">
			<Link>README.md</Link>
			<Visible>true</Visible>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Include="..\docs\**\*.md">
			<Link>docs\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<Visible>true</Visible>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Include="..\docs\**\*.docx">
			<Link>docs\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<Visible>true</Visible>
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- Exclude Windows platform files -->
	<ItemGroup>
		<Compile Remove="Platforms\Windows\**" />
		<MauiXaml Remove="Platforms\Windows\**" />
		<None Include="Platforms\Windows\**" />
	</ItemGroup>

	<!-- Keep legacy work-management sample modules in repo, but out of the travel app build -->
	<ItemGroup>
		<Compile Remove="Data\CategoryRepository.cs" />
		<Compile Remove="Data\JsonContext.cs" />
		<Compile Remove="Data\ProjectRepository.cs" />
		<Compile Remove="Data\SeedDataService.cs" />
		<Compile Remove="Data\TagRepository.cs" />
		<Compile Remove="Data\TaskRespository.cs" />
		<Compile Remove="Models\Category.cs" />
		<Compile Remove="Models\CategoryChartData.cs" />
		<Compile Remove="Models\IconData.cs" />
		<Compile Remove="Models\Project.cs" />
		<Compile Remove="Models\ProjectsTags.cs" />
		<Compile Remove="Models\ProjectTask.cs" />
		<Compile Remove="Models\Tag.cs" />
		<Compile Remove="PageModels\**" />
		<Compile Remove="Pages\MainPage.xaml.cs" />
		<Compile Remove="Pages\ManageMetaPage.xaml.cs" />
		<Compile Remove="Pages\ProjectDetailPage.xaml.cs" />
		<Compile Remove="Pages\ProjectListPage.xaml.cs" />
		<Compile Remove="Pages\TaskDetailPage.xaml.cs" />
		<Compile Remove="Pages\Controls\**" />
		<Compile Remove="Utilities\ProjectExtensions.cs" />
		<Compile Remove="Utilities\TaskUtilities.cs" />
		<Compile Remove="Services\Abstractions .cs" />
		<MauiXaml Remove="Pages\MainPage.xaml" />
		<MauiXaml Remove="Pages\ManageMetaPage.xaml" />
		<MauiXaml Remove="Pages\ProjectDetailPage.xaml" />
		<MauiXaml Remove="Pages\ProjectListPage.xaml" />
		<MauiXaml Remove="Pages\TaskDetailPage.xaml" />
		<MauiXaml Remove="Pages\Controls\**" />
		<None Include="Data\CategoryRepository.cs" />
		<None Include="Data\JsonContext.cs" />
		<None Include="Data\ProjectRepository.cs" />
		<None Include="Data\SeedDataService.cs" />
		<None Include="Data\TagRepository.cs" />
		<None Include="Data\TaskRespository.cs" />
		<None Include="Models\Category.cs" />
		<None Include="Models\CategoryChartData.cs" />
		<None Include="Models\IconData.cs" />
		<None Include="Models\Project.cs" />
		<None Include="Models\ProjectsTags.cs" />
		<None Include="Models\ProjectTask.cs" />
		<None Include="Models\Tag.cs" />
		<None Include="PageModels\**" />
		<None Include="Pages\MainPage.xaml" />
		<None Include="Pages\MainPage.xaml.cs" />
		<None Include="Pages\ManageMetaPage.xaml" />
		<None Include="Pages\ManageMetaPage.xaml.cs" />
		<None Include="Pages\ProjectDetailPage.xaml" />
		<None Include="Pages\ProjectDetailPage.xaml.cs" />
		<None Include="Pages\ProjectListPage.xaml" />
		<None Include="Pages\ProjectListPage.xaml.cs" />
		<None Include="Pages\TaskDetailPage.xaml" />
		<None Include="Pages\TaskDetailPage.xaml.cs" />
		<None Include="Pages\Controls\**" />
		<None Include="Utilities\ProjectExtensions.cs" />
		<None Include="Utilities\TaskUtilities.cs" />
		<None Include="Services\Abstractions .cs" />
	</ItemGroup>
</Project>

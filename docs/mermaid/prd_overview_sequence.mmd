sequenceDiagram
    actor User as User
    participant App as MapPage
    participant Sync as PoiSyncService
    participant API as MapApi
    participant DB as SQLite
    participant GPS as AndroidLocationService
    participant Geo as AndroidGeofenceService
    participant Narr as NarrationManager
    participant History as PlaybackApiClient

    User->>App: Open app and map
    App->>Sync: SyncOnceAsync()
    Sync->>API: GET /api/v1/pois
    API-->>Sync: POI list
    Sync->>DB: SaveAsync(poi)
    App->>Geo: RegisterAsync(POIs)
    App->>GPS: StartTracking()
    GPS-->>App: Location update
    App->>Narr: HandleAsync() when Near or Enter
    Narr-->>User: Play audio or TTS
    App->>History: LogAsync()
    History->>API: POST /api/v1/history
